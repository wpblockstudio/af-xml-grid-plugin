{
  "apiVersion": 3,
  "name": "af/xml-grid",
  "title": "XML Grid",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Fetches an XML feed and displays items in a grid.",
  "attributes": {
    "settings": {
      "type": "object",
      "default": {}
    }
  },
  "allowedBlocks": [
    "af/xml-grid-card"
  ],
  "supports": {
    "layout": false,
    "interactivity": true,
    "color": {
      "background": true,
      "text": true,
      "link": false,
      "gradients": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true
    },
    "spacing": {
      "blockGap": [
        "horizontal",
        "vertical"
      ],
      "margin": true,
      "padding": true
    }
  },
  "viewScriptModule": "file:./view.js",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}
