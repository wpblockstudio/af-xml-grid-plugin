{
  "apiVersion": 3,
  "name": "af/xml-grid-content",
  "title": "XML Grid Content",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Displays content from an XML feed item.",
  "ancestor": [
    "af/xml-grid-card"
  ],
  "attributes": {
    "settings": {
      "type": "object",
      "default": {}
    }
  },
  "styles": [
    {"name": "inline", "label": "Inline"}
  ],
  "usesContext": ["af/xmlNode"],
  "supports": {
    "layout": false,
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "dimensions": {
      "aspectRatio": true
    },
    "typography": {
      "textAlign": true,
      "fontSize": true,
      "fontStyle": true,
      "lineHeight": true,
      "letterSpacing": true,
      "__experimentalTextDecoration": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalTextTransform": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}
